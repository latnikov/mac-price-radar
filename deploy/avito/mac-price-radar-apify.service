[Unit]
Description=Mac Price Radar Apify collector and Avito signals (dev)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=radar
Group=radar
WorkingDirectory=/srv/mac-price-radar/dev
EnvironmentFile=/etc/mac-price-radar/apify-dev.env
EnvironmentFile=-/etc/mac-price-radar/avito-alerts.env
ExecStart=/usr/bin/node scripts/avito-monitor-worker.mjs
TimeoutStartSec=10min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/mac-price-radar/dev/data/private

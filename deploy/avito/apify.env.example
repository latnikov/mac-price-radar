# Store real values only in /etc/mac-price-radar/apify-dev.env, root:root 0600.
APIFY_TOKEN=
AVITO_DATA_DIR=data/private/avito
AVITO_APIFY_BUDGET_USD=5
AVITO_APIFY_MAX_RUN_USD=0.40
AVITO_APIFY_MAX_RESULTS=45
# This actor allows ten lifetime runs on Apify Free, including the initial test.
AVITO_APIFY_RUN_LIMIT=10
# Absolute approved period. No automatic renewal after it ends.
AVITO_APIFY_PERIOD_START=2026-09-30T18:41:36.898Z
AVITO_APIFY_PERIOD_END=2026-10-07T18:41:36.898Z
# Google Apps Script relay settings belong in /etc/mac-price-radar/avito-alerts.env.
# AVITO_ALERT_RELAY_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec
# AVITO_ALERT_RELAY_SECRET=

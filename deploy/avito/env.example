# Defaults to no network. Enable only after validating ordinary site access.
# AVITO_TRANSPORT=http
# AVITO_SEARCH_URL=https://www.avito.ru/nizhniy_novgorod/noutbuki?q=macbook
AVITO_DATA_DIR=data/private/avito
# Explicit mapping of verified Avito profile IDs to existing retailer names.
# AVITO_SELLER_MAP_FILE=/etc/mac-price-radar/avito-sellers.json
# Offline replay: HTML pages + manifest. This performs no network requests.
# AVITO_CAPTURE_MANIFEST=/srv/avito-capture/manifest.json

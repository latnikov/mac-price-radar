[Unit]
Description=Verified compressed MacBookBro database and configuration backup
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/lib/macbookbro-ops/maintenance.py backup
TimeoutStartSec=30min
UMask=0077
Nice=15
CPUWeight=10
CPUQuota=35%
IOWeight=10
MemoryMax=192M
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/var/backups/macbookbro-platform /var/lib/macbookbro-ops
ReadWritePaths=/var/lib/macbookbro-shop /var/lib/macbookbro-orders /srv/mac-price-radar/dev/data/private /srv/mac-price-radar/prod/data/private

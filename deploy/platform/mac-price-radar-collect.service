[Unit]
Description=Canonical dev parser price collection
Wants=network-online.target
After=network-online.target mac-price-radar@dev.service

[Service]
Type=oneshot
User=radar
Group=radar
WorkingDirectory=/srv/mac-price-radar/dev
EnvironmentFile=/etc/mac-price-radar/dev.env
EnvironmentFile=-/etc/mac-price-radar/telegram.env
Environment=LIVE=1
ExecStart=/usr/bin/node --max-old-space-size=256 scripts/build-data.mjs
TimeoutStartSec=18min
UMask=0077
Nice=10
CPUWeight=10
CPUQuota=50%
MemoryMax=448M
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/mac-price-radar/dev/data

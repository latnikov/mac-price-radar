[Unit]
Description=Explicit measured SQLite page packing of price history

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/lib/macbookbro-ops/compact.py --manage-services --pages-only --page-size=16384
ExecStopPost=/usr/bin/systemctl start mac-price-radar@dev.service mac-price-radar-collect.timer mac-price-radar-apify.timer
TimeoutStartSec=40min
UMask=0077
Nice=10
CPUQuota=50%
MemoryMax=256M
PrivateTmp=true

STORE_ORIGIN=https://macbookbro.ru
STORE_PORT=4190
STORE_DB=/var/lib/macbookbro-shop/shop.sqlite
STORE_MEDIA_DIR=/var/lib/macbookbro-shop/media
STORE_DEV_URL=http://127.0.0.1:4174/api/table
STORE_PARSER_ORIGIN=http://127.0.0.1:4174
STORE_PRICE_MAX_AGE_MS=14400000
STORE_SYNC_INTERVAL_MS=60000
STORE_TRUST_PROXY=loopback
STORE_REQUESTS_PER_MINUTE=90
# Configure a >=16-character password file, or trusted reverse-proxy auth below.
# STORE_ADMIN_PASSWORD_FILE=/etc/macbookbro-shop/admin-password
# STORE_MANAGER_PASSWORD_FILE=/etc/macbookbro-shop/manager-password
# Proxy MUST remove client X-Store-Admin-Key and only set its value AFTER authentication.
# STORE_PROXY_AUTH_TOKEN_FILE=/etc/macbookbro-shop/proxy-token
# STORE_FEED_TOKEN=<at least 32 cryptographically random characters>
# STORE_TELEGRAM_TOKEN=
# STORE_TELEGRAM_CHANNEL=@channel
# STORE_MOYSKLAD_TOKEN=
# STORE_MOYSKLAD_PRICE_TYPE=<UUID>
# STORE_MOYSKLAD_ORGANIZATION=<UUID>
# STORE_MOYSKLAD_COUNTERPARTY=<UUID>
# STORE_OWN_SELLER_IDS=<Avito profile IDs, comma-separated>
# STORE_AVITO_FEED_ENABLED=1 only after validation in the account
# STORE_AVITO_FIELDS_FILE=/etc/macbookbro-shop/avito-fields.json
# Private account messenger integration. Keep actual keys only in protected server env files.
# AVITO_CLIENT_ID=
# AVITO_CLIENT_SECRET=
# AVITO_ACCOUNT_ID=
# AVITO_LABEL=Авито 1
# AVITO_2_CLIENT_ID=
# AVITO_2_CLIENT_SECRET=
# AVITO_2_ACCOUNT_ID=
# AVITO_2_LABEL=Авито 2
# Enable sending only after account identity and messenger subscription are verified.
# STORE_INBOX_SEND_ENABLED=1
# STORE_CONTACT_PHONE=
# STORE_OPENING_HOURS=
# STORE_SELLER_DETAILS=

# Customer catalogue, account, delivery and CRM data import
STORE_AUTO_CATALOG=1
STORE_DATA_SYNC_INTERVAL_MS=300000
# STORE_MOYSKLAD_TOKEN_FILE=/etc/macbookbro-shop/moysklad-token
# STORE_MOYSKLAD_DELIVERY_SERVICE=<UUID of the delivery service>
# STORE_MAIL_WEBHOOK_URL=https://your-mail-provider.example/send
# STORE_MAIL_WEBHOOK_TOKEN_FILE=/etc/macbookbro-shop/mail-token
# Private Telegram Business inbox, separate from the publication channel bot above.
# STORE_CRM_TELEGRAM_BOT_TOKEN_FILE=/etc/macbookbro-shop/crm-telegram-token
# STORE_CRM_TELEGRAM_EXPECTED_BOT=mbroadmin_bot
# STORE_TELEGRAM_ACCOUNT_ID=<verified numeric owner ID from Desktop export>
# Enable Business/Secretary Mode in BotFather, then connect the bot in the owner account.
# STORE_TELEGRAM_SEND_ENABLED=1
# Optional verified direct route if the default Telegram DNS address is unreachable:
# STORE_TELEGRAM_API_IPV4=<Telegram API IPv4, TLS hostname is always api.telegram.org>
# Optional legacy signed ingestion, only if a separately authorized worker exists:
# STORE_TELEGRAM_INGEST_TOKEN_FILE=/etc/macbookbro-shop/telegram-ingest-token

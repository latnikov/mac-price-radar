[Unit]
Description=Makbuchnaya storefront and CRM
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=radar
Group=radar
WorkingDirectory=/srv/macbookbro-shop
EnvironmentFile=/etc/macbookbro-shop.env
ExecStart=/usr/bin/node /srv/macbookbro-shop/storefront/server.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/macbookbro-shop

[Install]
WantedBy=multi-user.target
